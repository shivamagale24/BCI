# ================================================================
# NeuroCare BCI - Environment Variables Configuration Template
# Copy this file to .env and configure your local settings.
# ================================================================

# Application
PROJECT_NAME="NeuroCare BCI Hospital Management"
ENVIRONMENT="development"
DEBUG=True

# Security (Change to a strong random key in production)
SECRET_KEY="replace-this-with-a-secure-random-32-byte-hex-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Primary MySQL Connection String:
DATABASE_URL="mysql+pymysql://root:YOUR_PASSWORD@127.0.0.1:3306/neurocare_bci?charset=utf8mb4"

# Fallback SQLite Connection String (used automatically if MySQL is unavailable):
SQLITE_URL="sqlite:///./neurocare.db"

# Server Ports
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
FRONTEND_PORT=5173
